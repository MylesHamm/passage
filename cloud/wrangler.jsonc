{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "passage-live-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "web_socket_compression"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://myleshamm.github.io",
    "APP_VERSION": "0.8.0-preview.1",
    "COLLECTOR_PAUSED": "false"
  },
  "durable_objects": {
    "bindings": [{"name": "PASSAGE_DATA", "class_name": "PassageCollector"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PassageCollector"]}],
  "triggers": {"crons": ["*/15 * * * *"]},
  "observability": {"enabled": true}
}
