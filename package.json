{
  "name": "passage-maritime-watch",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Regional war monitor: Hormuz tanker traffic, transits, oil prices and market odds from the Gulf to the Red Sea.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "cloud:check": "wrangler deploy --dry-run --config cloud/wrangler.jsonc --outdir build/worker",
    "cloud:dev": "wrangler dev --config cloud/wrangler.jsonc",
    "cloud:deploy": "wrangler deploy --config cloud/wrangler.jsonc",
    "check:events": "node scripts/check-events.mjs && node --test test/war-events.test.mjs test/curated-events.test.mjs test/ops-events.test.mjs"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
